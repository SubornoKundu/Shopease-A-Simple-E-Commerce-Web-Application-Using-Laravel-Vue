APP_NAME=ShopEase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# As required by the assignment brief, ShopEase runs on MySQL.
# Create an empty database first, e.g.: CREATE DATABASE shopease;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopease
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# OTPs are emailed. The "log" driver (default below) writes the email
# -- OTP code included -- to storage/logs/laravel.log instead of sending
# a real email, which is perfect for local development and for recording
# the demo video without needing a real mailbox. Swap in real SMTP
# credentials (e.g. Gmail, Mailtrap) to deliver actual emails.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@shopease.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# One-time password settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# Demo SSLCommerz gateway (no real merchant account needed -- see README)
SSLCOMMERZ_STORE_ID=shopease_demo
SSLCOMMERZ_STORE_PASSWORD=demo_password
SSLCOMMERZ_SANDBOX=true
